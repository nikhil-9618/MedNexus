# ============================================================
# MedNexus API — Environment variables (copy to .env and fill)
# Never commit the real .env file. Placeholders only here.
# ============================================================

NODE_ENV=development
PORT=5000

# MongoDB connection. Leave EMPTY to auto-start a local in-memory
# MongoDB (mongodb-memory-server) for development. For a persistent
# local DB use: mongodb://127.0.0.1:27017/mednexus
# For production use a MongoDB Atlas connection string.
MONGODB_URI=

# REQUIRED in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-min-32-chars

JWT_EXPIRES_IN=7d
JWT_ISSUER=mednexus-api
JWT_AUDIENCE=mednexus-client

# Frontend origin allowed by CORS (comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173

# Trust proxy (set to 1 when deploying behind Render/Vercel proxies)
TRUST_PROXY=0

# Redirect plain HTTP to HTTPS. Defaults to true when NODE_ENV=production.
FORCE_HTTPS=false

# Database name used when MONGODB_URI has no path segment.
MONGODB_DB=mednexus

# Global/auth/API rate-limit ceilings (requests per window).
RL_GLOBAL_MAX=900
RL_AUTH_MAX=25
RL_API_MAX=180

# Request body cap — keeps oversized payloads out of the parsers.
BODY_LIMIT=32kb

# NOTE: the browser bundle carries NO secrets. Its only build-time values are
# VITE_API_URL and VITE_ANALYTICS_DOMAIN — see src/client/.env.example.

# Optional: external AI provider key for the AI assistant.
# Leave empty to use the built-in deterministic FAQ/navigation assistant.
AI_API_KEY=

# Seed bootstrap (local development only — safe placeholder values)
SEED_ADMIN_PASSWORD=Admin@MedNexus2026
SEED_DOCTOR_PASSWORD=Doctor@MedNexus2026
SEED_PATIENT_PASSWORD=Patient@MedNexus2026

# Bcrypt cost factor (10-14)
BCRYPT_ROUNDS=10
