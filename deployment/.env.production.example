# ---------------------------------------------------------------------------
# MedNexus — production environment template
# Copy to deployment/.env (git-ignored) and fill in real values.
#   cp deployment/.env.production.example deployment/.env
# NEVER commit a filled-in copy. NEVER expose these to the browser — the client
# bundle only ever contains VITE_API_URL / VITE_ANALYTICS_DOMAIN.
# ---------------------------------------------------------------------------

# ---------- Database ----------
# MongoDB Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/mednexus
# self-hosted : mongodb://mongo:27017/mednexus   (docker compose service name)
MONGODB_URI=
MONGODB_DB=mednexus

# ---------- API ----------
NODE_ENV=production
PORT=5000
API_PORT=5000

# Must be >= 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated browser origins allowed by CORS.
CLIENT_URL=https://your-frontend.vercel.app

# Behind a reverse proxy / cloud load balancer set to 1 so the real client IP
# reaches the rate limiters through X-Forwarded-For.
TRUST_PROXY=1
# Redirect any plain-HTTP request to HTTPS (leave false locally).
FORCE_HTTPS=true

BCRYPT_ROUNDS=12
BODY_LIMIT=32kb

# ---------- Frontend build-time variables ----------
# Optional: omit to use the same-origin "/api" path.
VITE_API_URL=
# Optional privacy-friendly analytics host; unset disables analytics entirely.
VITE_ANALYTICS_DOMAIN=
WEB_PORT=8080

# ---------- Seeded demo accounts (synthetic data only) ----------
SEED_ADMIN_PASSWORD=
SEED_DOCTOR_PASSWORD=
SEED_PATIENT_PASSWORD=
