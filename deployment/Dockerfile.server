# ---------------------------------------------------------------------------
# MedNexus API — production image
#
# Build from the REPOSITORY ROOT (npm workspaces need the root lockfile):
#   docker build -f deployment/Dockerfile.server -t mednexus-api .
#
# The runtime stage sets NODE_ENV=production, so src/server/config/env.js
# refuses to boot unless MONGODB_URI (>= 32 char JWT_SECRET) and CLIENT_URL
# are supplied. mongodb-memory-server is an optional dependency and is NOT
# installed here — production always talks to a real MongoDB.
# ---------------------------------------------------------------------------
FROM node:20-alpine AS deps

WORKDIR /app

# Only the manifests are needed for dependency resolution (better layer cache).
COPY package.json package-lock.json ./
COPY src/server/package.json ./src/server/package.json
COPY src/client/package.json ./src/client/package.json

# --omit=optional skips mongodb-memory-server (dev-only, ~80 MB of binaries).
RUN npm ci --omit=dev --omit=optional --workspace mednexus-server --include-workspace-root \
    && npm cache clean --force

# ---------------------------------------------------------------------------
FROM node:20-alpine AS runtime

ENV NODE_ENV=production \
    PORT=5000

WORKDIR /app

# tini reaps zombies and forwards SIGTERM so the API's graceful shutdown runs.
RUN apk add --no-cache tini

COPY --from=deps /app/node_modules ./node_modules
COPY package.json ./
COPY src/server ./src/server

# Run unprivileged — the node image already ships a `node` user.
USER node

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||5000)+'/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "src/server/server.js"]
