# ---------------------------------------------------------------------------
# MedNexus Web — client environment template.
# Copy to src/client/.env.local (git-ignored). Only VITE_* values reach the
# browser bundle, so never put a secret here.
# ---------------------------------------------------------------------------

# API origin. Omit (or leave empty) to call the same-origin "/api" path, which
# is what the Vite dev proxy and the nginx container both expect.
# Set this only when the API is hosted on a different origin, e.g.:
#   VITE_API_URL=https://mednexus-api.onrender.com/api
VITE_API_URL=

# Optional privacy-friendly analytics host (e.g. plausible.io). Unset => no
# analytics script is loaded at all, and no third-party request is made.
VITE_ANALYTICS_DOMAIN=
