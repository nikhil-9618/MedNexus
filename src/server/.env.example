# ---------------------------------------------------------------------------
# MedNexus API — environment template.
# Copy to src/server/.env (git-ignored). Never commit a filled-in copy.
# The API refuses to boot in NODE_ENV=production unless MONGODB_URI, a >=32
# character JWT_SECRET and CLIENT_URL are present (src/server/config/env.js).
# ---------------------------------------------------------------------------

# ---------- Runtime ----------
NODE_ENV=development
PORT=5000
LOG_REQUESTS=true

# ---------- Database ----------
# Leave EMPTY in development to auto-start an ephemeral in-memory MongoDB
# (mongodb-memory-server). Data resets on every restart.
# Set it to use a real instance: mongodb://127.0.0.1:27017/mednexus
MONGODB_URI=
MONGODB_DB=mednexus

# ---------- Auth ----------
# Development may omit this; production requires >= 32 characters.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---------- Browser origin(s) allowed by CORS (comma-separated) ----------
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# ---------- Reverse proxy / transport ----------
# 1 when running behind nginx, Render, Railway, etc. so rate limiting sees the
# real client IP via X-Forwarded-For.
TRUST_PROXY=0
# Redirect plain HTTP to HTTPS. Defaults to true in production.
FORCE_HTTPS=false

# ---------- Hardening knobs ----------
BCRYPT_ROUNDS=10
BODY_LIMIT=32kb
RL_GLOBAL_MAX=900
RL_AUTH_MAX=25
RL_API_MAX=180

# ---------- Seeded demo accounts (synthetic data only) ----------
SEED_ADMIN_PASSWORD=Admin@MedNexus2026
SEED_DOCTOR_PASSWORD=Doctor@MedNexus2026
SEED_PATIENT_PASSWORD=Patient@MedNexus2026

# ---------- Optional AI assistant ----------
# Leave empty to use the built-in rule-based assistant.
AI_API_KEY=
