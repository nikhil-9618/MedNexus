# ---------------------------------------------------------------------------
# MedNexus API — environment template.
# Copy to src/server/.env (git-ignored). Never commit a filled-in copy.
# The API refuses to boot in NODE_ENV=production unless MONGODB_URI, a >=32
# character JWT_SECRET and CLIENT_URL are present (src/server/config/env.js).
# ---------------------------------------------------------------------------

# ---------- Runtime ----------
NODE_ENV=development
PORT=5000
LOG_REQUESTS=true

# ---------- Database ----------
# Leave EMPTY in development to auto-start a local MongoDB owned by the server
# process (mongodb-memory-server). It is backed by src/server/.data/mongodb, so
# registrations and pending verification codes survive a restart.
# Set it to use a real instance: mongodb://127.0.0.1:27017/mednexus
MONGODB_URI=
MONGODB_DB=mednexus

# ---------- Auth ----------
# Development may omit this; production requires >= 32 characters.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---------- Browser origin(s) allowed by CORS (comma-separated) ----------
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# ---------- Reverse proxy / transport ----------
# 1 when running behind nginx, Render, Railway, etc. so rate limiting sees the
# real client IP via X-Forwarded-For.
TRUST_PROXY=0
# Redirect plain HTTP to HTTPS. Defaults to true in production.
FORCE_HTTPS=false

# ---------- Hardening knobs ----------
BCRYPT_ROUNDS=10
BODY_LIMIT=32kb
RL_GLOBAL_MAX=900
RL_AUTH_MAX=25
RL_API_MAX=180

# ---------- First administrator ----------
# No accounts are seeded. Create the first admin once with:
#   npm run create-admin
# These let that command run unattended (a hosted deploy has no interactive
# shell). Omit ADMIN_PASSWORD to have a strong one generated and printed.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# ---------- Optional AI assistant ----------
# Leave empty to use the built-in rule-based assistant.
AI_API_KEY=

# ---------- Outbound email (verification codes) ----------
# Two transports are supported; the server picks whichever is configured and
# logs the choice at boot. With neither set, codes only reach the console
# transport (the server log, plus an amber box on the verification screen).
#
# 1) Resend HTTP API. Create a key at https://resend.com/api-keys.
# NOTE: without a domain verified in Resend, mail is sent from its shared
# sandbox sender and ONLY delivers to your own Resend account address.
RESEND_API_KEY=
# 2) SMTP — works with any provider, or a personal mailbox such as a Gmail
#    app password (https://myaccount.google.com/apppasswords). SMTP is the only
#    option that reaches arbitrary recipients when you cannot verify a domain.
#    Set SMTP_USER + SMTP_PASS at minimum; the rest have sensible defaults.
SMTP_HOST=
SMTP_PORT=587
# Implicit TLS (port 465). Defaults to true only when SMTP_PORT=465.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Must be an address the chosen transport is allowed to send as. When unset,
# Resend falls back to its sandbox sender and SMTP uses SMTP_USER.
EMAIL_FROM=
EMAIL_REPLY_TO=

# ---------- Hosted demo switches (both default OFF) ----------
# A hosted instance has no shell to run `npm run seed` in, so it can write the
# reference data (departments + settings) itself while the database is empty.
# It creates NO accounts.
SEED_ON_EMPTY=false
# Only needed when RESEND_API_KEY is empty and an OTP still has to be
# completable. It echoes the code to the client for DEMO data only — never
# enable it where real patient information could appear.
OTP_DEV_ECHO=false
