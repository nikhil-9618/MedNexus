{
  "name": "mednexus",
  "version": "1.0.0",
  "private": true,
  "description": "MedNexus — Secure Clinic & Appointment Management (PS-04 HealthTech). Synthetic/demo data only.",
  "license": "MIT",
  "privateWorkspaces": true,
  "workspaces": [
    "src/client",
    "src/server"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "npm install --workspaces --include-workspace-root",
    "seed": "npm run seed --workspace mednexus-server",
    "server": "npm run dev --workspace mednexus-server",
    "client": "npm run dev --workspace mednexus-client",
    "dev": "concurrently -n api,web -c blue,cyan \"npm run dev --workspace mednexus-server\" \"npm run dev --workspace mednexus-client\"",
    "build": "npm run build --workspace mednexus-client",
    "start": "npm start --workspace mednexus-server",
    "test:server": "npm test --workspace mednexus-server",
    "test:client": "npm test --workspace mednexus-client",
    "test:netlify": "node --test src/server/tests/netlify-account.test.js && node --import tsx --test tests/netlify-auth.test.mjs",
    "typecheck:netlify": "tsc -p tsconfig.netlify.json",
    "security-checklist": "npm run security-checklist --workspace mednexus-server"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^1.0.0-beta.22",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@netlify/database": "^2.0.1",
    "@netlify/functions": "^6.0.2",
    "@netlify/identity": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^1.0.0-beta.22",
    "jsonwebtoken": "^9.0.3"
  }
}
